# Ligação ao PostgreSQL. Na Vercel é criada automaticamente ao ligar a base de dados Neon (Storage).
# Para correr no seu computador, copie o valor de DATABASE_URL da Vercel (Settings → Environment Variables).
DATABASE_URL=postgres://utilizador:senha@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Conta de administrador criada na primeira utilização (mude antes de publicar!)
ADMIN_EMAIL=admin@turismo360.ao
ADMIN_PASSWORD=mude-esta-senha

# 0 = não criar clientes e reservas de demonstração
SEED_DEMO=1

# Protege a tarefa agendada dos lembretes (a Vercel envia-a automaticamente)
CRON_SECRET=

# ---------- Entrada com redes sociais (opcional) ----------
# Cada botão fica activo quando as variáveis do fornecedor estão definidas.
# Endereço de retorno a registar em cada fornecedor: https://O-SEU-SITE/api/auth/oauth/<google|facebook|microsoft>/retorno
# (o painel, em «Entrada com redes sociais», mostra os endereços exactos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Opcional: endereço público fixo (ex.: https://turismo-digital-360.vercel.app) e segredo para assinar o "state"
PUBLIC_URL=
AUTH_SECRET=

# Segundos sem actividade até a sessão terminar (por omissão 60)
SESSAO_INATIVIDADE_S=60

# Angola 365º — ENDA AI e pesquisa diária (opcionais)
# Na Vercel o AI Gateway funciona com o OIDC do projecto; defina a chave só se não estiver activo.
AI_GATEWAY_API_KEY=
ENDA_MODELO=
PESQUISA_MODELO=
ENDA_LIMITE=40
# Protege /api/cron/* (a Vercel envia-o automaticamente nas tarefas agendadas)
CRON_SECRET=
